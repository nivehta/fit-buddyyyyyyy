# FitBuddy Environment Configuration
# Replace with your actual Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Configuration (Defaults to current fast/strong models)
STRONG_GEMINI_MODEL=gemini-2.5-flash
FAST_GEMINI_MODEL=gemini-2.5-flash

# Database Configuration
DATABASE_URL=sqlite:///./fitbuddy.db

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Admin Security Key
ADMIN_SECRET_KEY=admin123
